height: 0;\n  }\n  .ppt-skel-sxs-v3-rail {\n    flex: 0 0 232px;\n    background-color: #ffffff;\n    background-image: linear-gradient(to bottom, #ffffff, #f1f1f1);\n    background-attachment: fixed;\n    background-repeat: repeat-x;\n    border-right: 1px solid #edebe9;\n    overflow: hidden;\n  }\n  .ppt-skel-sxs-v3-rail .ppt-skel-sxs-grid-pane {\n    padding: 16px 12px 24px 28px;\n    background: transparent;\n    align-items: flex-start;\n  }\n  .ppt-skel-sxs-v3-rail .ppt-skel-sxs-grid .ppt-skel-sxs-slide {\n    margin: 0 auto 18px auto;\n    border-radius: 2px;\n  }\n  .ppt-skel-sxs-v3-rail .ppt-skel-sxs-grid .ppt-skel-slide-img,\n  .ppt-skel-sxs-v3-rail .ppt-skel-sxs-grid .ppt-skel-sxs-slide.ppt-previewer-slide-image::before,\n  .ppt-skel-sxs-v3-rail .ppt-skel-sxs-slide-placeholder::before {\n    border-radius: 2px;\n  }\n  /* Thumbnail images use the app\'s #d2d2d8 border, no shadow (.ThumbnailImageContainer). */\n  .ppt-skel-sxs-v3-rail .ppt-skel-sxs-slide-placeholder::before {\n    outline-color: #d2d2d8;\n  }\n  .ppt-skel-sxs-v3-rail .ppt-skel-sxs-grid .ppt-skel-sxs-slide,\n  .ppt-skel-sxs-v3-rail .ppt-skel-sxs-slide-placeholder::before,\n  .ppt-skel-sxs-v3-rail .ppt-skel-sxs-grid .ppt-skel-sxs-slide-selected {\n    box-shadow: none;\n  }\n  .ppt-skel-sxs-v3-rail .ppt-skel-sxs-grid .ppt-skel-sxs-slide-selected {\n    outline: 3px solid #f07151;\n    outline-offset: 0;\n  }\n  /*\n   * Thumbnail-pane number matches the app\'s .ThumbnailSlideNumber: a bare "N"\n   * (not "N of total") in a left gutter, #666666, turning #ba3201 when selected.\n   * font-size:0 on the label hides the trailing " of N" text node; the\n   * current-number span restores a visible size.\n   */\n  .ppt-skel-sxs-v3-rail .ppt-skel-sxs-slide-number {\n    top: 2px;\n    left: -22px;\n    font-size: 0;\n    color: #666666;\n  }\n  .ppt-skel-sxs-v3-rail .ppt-skel-sxs-slide-number-current {\n    font-size: 13px;\n    font-weight: 400;\n    color: #666666;\n  }\n  .ppt-skel-sxs-v3-rail\n 